{
  "name": "qualio-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "seo:prepare": "node scripts/prepare-seo.mjs",
    "check": "node --check app.js && node --check server.mjs && node --check seo.mjs && node --check guide.mjs && node --check content.mjs && node --check scripts/prepare-seo.mjs && node --check pilot.mjs && node --check scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve:production": "node --env-file-if-exists=.env server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  },
  "dependencies": {
    "nodemailer": "10.6.1"
  }
}
