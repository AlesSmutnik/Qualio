# Zkopírujte jako .env. Žádné skutečné údaje neposílejte do klientského JavaScriptu.
# Nastavení poskytne vlastník e-mailové služby. Bez kompletní konfigurace API vrací 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Jedna skutečná adresa pro každou hodnotu (nikoli formát "Jméno <adresa>").
PILOT_FROM=
PILOT_TO=
OPERATOR_NAME=
OPERATOR_EMAIL=
# Privátní lokální náhled. Na hostingu nastavte vazbu podle reverse proxy.
HOST=127.0.0.1
PORT=3000
